{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "node scripts/build.js notashelf.dev build",
    "build:web": "node scripts/build.js notashelf.dev build",
    "build:all": "node scripts/build.js --all",
    "dev": "node scripts/dev.js notashelf.dev dev",
    "preview": "pnpm --filter ./apps/notashelf.dev run preview",
    "check": "pnpm --filter ./apps/notashelf.dev run check",
    "check:projects": "node scripts/check-project-catalog.js",
    "fmt": "prettier . --write",
    "lint": "eslint **/*.{ts,js,astro,svelte}",
    "test": "vitest",
    "test:run": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:web": "vitest run --project notashelf.dev",
    "test:ci": "vitest run --coverage",
    "test:mutants": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/eslint": "^9.6.1",
    "@types/postcss-normalize": "^9.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/utils": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "3.23.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-astro-organize-imports": "^0.4.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "cssnano": "^9.1.2",
    "glob": "^13.0.6",
    "he": "1.2.0",
    "postcss": "^8.5.28",
    "purgecss": "^8.0.0",
    "svelte": "5.57.1"
  }
}
